{
  "name": "ccfg-dap",
  "displayName": "CCFG Debug Adapter",
  "version": "0.1.0",
  "publisher": "tcos",
  "description": "Generic Debug Adapter for CCFG-based languages",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./out/debugAdapter.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "debuggers": [
      {
        "type": "ccfg",
        "label": "CCFG Debug",
        "runtime": "node",
        "program": "./out/debugAdapter.js",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "type": {
                "type": "string",
                "description": "Debug type",
                "default": "ccfg"
              },
              "request": {
                "type": "string",
                "enum": [
                  "launch",
                  "attach"
                ],
                "description": "Request type"
              },
              "name": {
                "type": "string",
                "description": "Name of the configuration"
              },
              "program": {
                "type": "string",
                "description": "Path to program/file to debug"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "trace": {
                "type": "boolean",
                "default": false
              },
              "language": {
                "type": "string",
                "description": "Language id (custom registry)"
              },
              "sourceFile": {
                "type": "string",
                "description": "Source file path"
              },
              "facadePath": {
                "type": "string",
                "description": "Generated DAP facade path"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ccfg",
            "request": "launch",
            "name": "Launch CCFG Program",
            "program": "${file}"
          }
        ],
        "breakpoints": [
          {
            "language": "*"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@types/node": "^14.14.37",
    "@types/vscode": "^1.66.0",
    "@vscode/debugadapter": "^1.56.0",
    "@vscode/debugadapter-testsupport": "^1.56.0",
    "await-notify": "^1.0.1",
    "base64-js": "^1.5.1",
    "glob": "^7.2.0",
    "mocha": "^11.7.5",
    "path-browserify": "^1.0.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.6.3"
  },
  "dependencies": {
    "fs": "^0.0.1-security"
  }
}
