{
  "name": "backend-compiler",
  "displayName": "backend-compiler",
  "description": "This is the backend interface that compiles a CCFG into executable code.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.56.0"
  },
  "main": "src/GeneratorInterface.ts",
  "types": "dist/GeneratorInterface.d.ts",
  "categories": [
    "Programming Languages"
  ],
  "files": [
    ".",
    "src",
    "dist"
  ],
  "exports": {
    "./compilerBackend": {
      "import": "./dist/compilerBackend.js",
      "require": "./dist/compilerBackend.js",
      "types": "./dist/compilerBackend.d.ts"
    },
    "./GeneratorInterface": {
      "import": "./dist/generator/GeneratorInterface.js",
      "require": "./dist/generator/GeneratorInterface.js",
      "types": "./dist/generator/GeneratorInterface.d.ts"
    },
    "./cppGenerator": {
      "import": "./dist/generator/cppGenerator.js",
      "require": "./dist/generator/cppGenerator.js",
      "types": "./dist/generator/cppGenerator.d.ts"
    },
    "./jsGenerator": {
      "import": "./dist/generator/jsGenerator.js",
      "require": "./dist/generator/jsGenerator.js",
      "types": "./dist/generator/jsGenerator.d.ts"
    },
    "./pythonGenerator": {
      "import": "./dist/generator/pythonGenerator.js",
      "require": "./dist/generator/pythonGenerator.js",
      "types": "./dist/generator/pythonGenerator.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "chevrotain": "^10.4.1",
    "commander": "^8.0.0",
    "langium": "~3.1.0",
    "vscode-languageclient": "^8.0.2",
    "vscode-languageserver": "^8.0.2",
    "vscode-uri": "^3.0.2",
    "ccfg": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^14.17.3",
    "@types/vscode": "^1.56.0",
    "@typescript-eslint/eslint-plugin": "^5.28.0",
    "@typescript-eslint/parser": "^5.28.0",
    "eslint": "^8.17.0",
    "langium-cli": "~3.1.0",
    "typescript": "^4.9.5"
  },
  "type": "module"
}
